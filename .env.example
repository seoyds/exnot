# Database
DB_PASSWORD=exnot_dev_password
DATABASE_URL=postgresql+asyncpg://exnot:exnot_dev_password@db:5432/exnot
DATABASE_URL_SYNC=postgresql+psycopg2://exnot:exnot_dev_password@db:5432/exnot

# Redis
REDIS_URL=redis://redis:6379/0

# OpenRouter (OpenAI-compatible LLM API)
OPENROUTER_API_KEY=sk-or-your-key-here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Email (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=ExNot Fee Alerts

# Application
SECRET_KEY=change-this-to-a-random-secret-key
APP_URL=https://exnot.thepram.dev
LOG_LEVEL=INFO

# Admin user (created on first run)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# AI Extraction
# AI_SECTION_CHAR_BUDGET=15000

# Per-task model routing (OpenRouter model IDs, all < $0.40/M tokens)
# AI_MODEL_TABLE_CLASSIFICATION=qwen/qwen3.5-flash-02-23
# AI_MODEL_ORCHESTRATOR=qwen/qwen3.5-flash-02-23
# AI_MODEL_FEE_EXTRACTION=deepseek/deepseek-v3.2-20251201
# AI_MODEL_FEE_VALIDATION=mistralai/mistral-small-3.1-24b-instruct
# AI_MODEL_CORRECTION=deepseek/deepseek-v3.2-20251201
# AI_MODEL_URL_DISCOVERY=qwen/qwen3.5-flash-02-23
# AI_MODEL_CHANGE_SUMMARY=qwen/qwen3.5-flash-02-23

# Budget guardrails
# AI_BUDGET_PER_EXCHANGE_USD=2.00
# AI_BUDGET_DAILY_USD=15.00

# PDF Parser backend: "pymupdf" (default) or "docling" (deep learning tables)
# PDF_PARSER_BACKEND=pymupdf

# URL Discovery (SerpAPI - serpapi.com)
SERPAPI_API_KEY=your-serpapi-key-here

# Cloudflare Tunnel (for exnot.thepram.dev)
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token-here
